# Tauri 签名私钥(绝不提交)
src-tauri/*.key
src-tauri/*.key.pub
# vendor SDK dump(常自带 demo 凭据,别提交;金蝶 SDK 的 conf.ini 曾误入历史,被 gitleaks 揪出)
docs/SDK_*/
# 凭据型配置文件(如金蝶 conf.ini 里的 X-KDApi-AppSec)
**/conf.ini
# 内部规划文档不进公开仓库(本地另有备份)
plans/

# graphify：官方建议提交图谱；仅忽略本机/中间产物
# 见 https://github.com/safishamsi/graphify Team setup
graphify-out/cost.json
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/.graphify_labels.json.sig
graphify-out/graph-app-lib.json
graphify-out/GRAPH_REPORT-app-lib.md
graphify-out/.labels-app-lib.json
# Graphify 重复运行产生的日期快照；根目录正式图谱仍提交
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
# 子目录抽取/合并用的中间 graphify-out（只保留仓库根 graphify-out/）
*/graphify-out/
.codex/
.cursor/
# AS0 Phase B evidence may contain model responses and runtime traces.
/artifacts/evals/
