{
  "name": "finwork",
  "version": "0.1.6",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "predev": "node scripts/link-worktree-node-modules.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/clean-standalone.mjs && node scripts/link-worktree-node-modules.mjs",
    "build": "next build",
    "start": "next start",
    "tauri": "tauri",
    "tauri:prepare": "node scripts/prepare-tauri.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "knowledge:reset": "node scripts/knowledge-reset.mjs",
    "test": "pnpm run test:core && pnpm run test:agent && pnpm run test:eval-kernel",
    "test:core": "node --import tsx tests/core.test.ts",
    "test:agent": "node --import tsx tests/as2-context-policy.test.ts && node --import tsx tests/pi/structure.mts && node --import tsx tests/pi/handlers.mts && node --import tsx tests/pi/cancellation.mts && node --import tsx tests/pi/main-service.mts && node --import tsx tests/pi/ask-user.mts && node --import tsx tests/pi/extension.mts && node --import tsx tests/pi/bash-sandbox.mts && node --import tsx tests/pi/model-pricing.mts && node --import tsx tests/pi/context-hooks.mts && node --import tsx tests/pi/live-and-compaction.mts",
    "test:eval-kernel": "node --import tsx tests/production-benchmark-executor.test.ts && node --import tsx tests/benchmark-evaluation-layers.test.ts && node --import tsx tests/general-agent-pilot.test.ts && node --import tsx tests/finance-professional-benchmark.test.ts && node --import tsx tests/benchmark-real-runner.test.ts",
    "test:smoke": "node --import tsx tests/smoke.test.ts",
    "test:documents": "node --import tsx tests/document-worker-pool.test.ts && node --import tsx tests/read-document.test.ts && node --import tsx tests/ocr-image.test.ts && node --import tsx tests/windows-hardening.test.ts",
    "test:spreadsheets": "node --import tsx tests/create-workbook.test.ts && node --import tsx tests/patch-workbook.test.ts && node --import tsx tests/patch-workbook-value-coercion.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "E2E_REAL=1 playwright test",
    "test:e2e:serve": "rm -rf .finwork-test/e2e-mock/appdata && FINANCE_AGENT_APP_DATA_DIR=.finwork-test/e2e-mock/appdata FINANCE_AGENT_MOCK_AGENT=1 FINANCE_AGENT_SECRET_BACKEND=file next dev -p 3997",
    "test:e2e:fast": "BASE_URL=http://127.0.0.1:3997 playwright test",
    "test:e2e:prod": "next build && PW_PROD=1 playwright test",
    "benchmarks:import": "node --import tsx scripts/benchmark-import.mts",
    "benchmarks:materialize": "node --import tsx scripts/benchmark-materialize.mts",
    "benchmarks:gaps": "node --import tsx scripts/benchmark-gaps.mts",
    "eval:benchmarks:fixtures": "node --import tsx scripts/benchmark-fixtures.mts",
    "eval:benchmarks:preflight": "node --import tsx scripts/benchmark-preflight.mts",
    "eval:benchmarks:real": "node --import tsx scripts/benchmark-real.mts",
    "eval:benchmarks:model-matrix": "node --import tsx scripts/benchmark-model-matrix.mts",
    "eval:benchmarks:model-rescore": "node --import tsx scripts/benchmark-model-rescore.mts",
    "eval:harness": "node --import tsx scripts/benchmark-harness.mts",
    "eval:history": "tsx tests/history-eval/supervisor.ts",
    "eval:knowledge": "node --import tsx scripts/knowledge-retrieval-eval.mts",
    "eval:resource-soak": "node --expose-gc --import tsx scripts/resource-soak.ts",
    "schema:golden:update": "node --import tsx scripts/generate-golden-schema.mts",
    "worker:demo": "python3 workers/finance_worker.py demo"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@microsoft/mxc-sdk": "0.7.0",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.7",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/react": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vscode/ripgrep": "^1.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "docx-preview": "^0.3.7",
    "exceljs": "^4.4.0",
    "geist": "^1.7.2",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.9.1",
    "motion": "^12.40.0",
    "next": "^15.3.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "postcss": "^8.5.15",
    "pptxgenjs": "^4.0.1",
    "radix-ui": "^1.5.0",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "react-file-icon": "^1.6.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.2.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^15.5.19",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
