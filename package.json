    "test:e2e:fast": "BASE_URL=http://127.0.0.1:3997 playwright test",
    "test:e2e:prod": "next build && PW_PROD=1 playwright test",
    "eval:golden": "tsx tests/golden/run.ts",
    "eval:history": "tsx tests/history-eval/supervisor.ts",
    "eval:golden:ci": "SKIP_LLM=true tsx tests/golden/run.ts",
    "eval:as0:validate": "tsx tests/as0/validate.ts",
    "eval:history:supervised": "tsx tests/history-eval/supervisor.ts",
    "eval:as0:snapshot": "tsx tests/as0/context-snapshot.ts",
    "eval:as0:phase-b": "tsx tests/as0/run.ts",
    "eval:as0:rescore": "tsx tests/as0/rescore.ts",
    "eval:as0:typecheck": "tsc -p tests/as0/tsconfig.json",
    "eval:ar10:text": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/run.mts text",
    "eval:ar10:tool": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/run.mts tool",
    "eval:ar10:subagent": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/subagent.mts",
    "eval:ar10:subagent-abort": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/subagent.mts abort",
    "eval:ar10:main": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/main-service.mts text",
    "eval:ar10:confirm": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/main-service.mts confirm",
    "eval:ar10:timeout": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/main-service.mts timeout",
    "eval:ar10:compaction": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/remaining.mts compaction",
    "eval:ar10:steering": "AR10_ALLOW_REAL=1 tsx scratchpad/spikes/ar10-pi-anthropic/remaining.mts steering",
    "eval:ar13:pi-only": "node scripts/ar13-pi-only-audit.mjs",
    "eval:ar12:query": "AR12_ALLOW_REAL=1 tsx scratchpad/spikes/ar12-pi-query/query-pipeline.mts",
    "eval:ar14:context": "tsx scripts/ar14-context-gate.mts",
    "eval:ar14:live": "AR14_ALLOW_REAL=1 tsx scratchpad/spikes/ar14-pi-only/context-live.mts",
    "eval:ar14:packaged": "node scripts/ar14-packaged-pi-smoke.mjs",
    "eval:ar14:local": "npm run typecheck && npm run test:pi && npm run eval:ar14:context && npm run build && npm run tauri:prepare && npm run eval:ar13:pi-only && npm run eval:ar14:packaged",
    "test:pi": "tsx tests/as2-context-policy.test.ts && tsx tests/pi/structure.mts && tsx tests/pi/handlers.mts && tsx tests/pi/cancellation.mts && tsx tests/pi/main-service.mts && tsx tests/pi/extension.mts && tsx tests/pi/bash-sandbox.mts && tsx tests/pi/model-pricing.mts && tsx tests/pi/context-hooks.mts && tsx tests/pi/live-and-compaction.mts",
    "worker:demo": "python3 workers/finance_worker.py demo"
  },
