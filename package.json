    "tauri:build": "tauri build",
    "tauri:info": "tauri info",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "knowledge:reset": "node scripts/knowledge-reset.mjs",
    "test": "npm run test:pi && node --import tsx tests/all.test.ts",
    "test:main": "node --import tsx tests/all.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "E2E_REAL=1 playwright test",
